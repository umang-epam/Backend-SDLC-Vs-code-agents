              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"granted\": true,\n  \"policyVersion\": \"v1.0\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/me/consents/{{consent_category}}",
              "host": [
